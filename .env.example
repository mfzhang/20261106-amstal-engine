# ==============================================================================
# AMSTAL SYSTEM ENVIRONMENT CONFIGURATION
# Universal configuration for amstal-engine and amstal-terminal
# ==============================================================================

# Core System Environment (development | staging | production)
AMSTAL_ENV=development

# IPC Wire Topology
AMSTAL_UDS_SOCKET=/tmp/amstal.sock
AMSTAL_WS_HOST=127.0.0.1
AMSTAL_WS_PORT=8194

# Storage Paths
AMSTAL_DATA_DIR=data/processed
AMSTAL_RAW_DATA_DIR=data/raw
AMSTAL_UNIVERSE_DIR=data/universe

# SEC EDGAR Mandatory Compliance (Must be valid org + reachable contact email)
SEC_EDGAR_USER_AGENT=AmstalResearch dev@yourdomain.com

# Market Data Vendor API Keys (Optional: Leave empty for free Daily OHLCV mode)
POLYGON_API_KEY=
TIINGO_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Local LLM Inference (Ollama)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

# Optional Cloud Batch Backfill Endpoint (Groq / Together / DeepInfra)
BATCH_LLM_API_KEY=
BATCH_LLM_BASE_URL=
